# ========================================================
# Hostinger Node.js & MySQL Environment Variables
# Fill these in Hostinger hPanel -> Advanced -> Node.js
# Or in backend/.env for local development
# ========================================================

PORT=3000
NODE_ENV=production

# Hostinger MySQL Database Credentials (found in hPanel -> Databases -> MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_hostinger_db_user
DB_PASSWORD=your_hostinger_db_password
DB_NAME=your_hostinger_db_name

# JWT Secret for Staff & Admin Authentication (generate a secure random string)
JWT_SECRET=swami_motors_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Domain configuration
PUBLIC_URL=https://autokundali.com
